---
import { localeMeta, localePath, locales, ui, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = 'zh', alternates = {} } = Astro.props;
const path = Astro.url.pathname;
const t = ui[locale];
const projectsHref = localePath(locale, '/projects/');
const toolsHref = localePath(locale, '/tools/');
const links = [
  { href: projectsHref, label: t.nav.projects },
  { href: toolsHref, label: t.nav.tools },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const availableLocales = locales.filter((item) => alternates[item]);
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href={localePath(locale, '/')}><span class="brand-mark" aria-hidden="true">☾</span>Sleepy Zone</a>
    <nav class="nav" aria-label={locale === 'zh' ? '主导航' : locale === 'en' ? 'Main navigation' : 'メインナビゲーション'}>
      {links.map((link) => (
        <a
          href={link.href}
          class={isActive(link.href) ? 'is-active' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-track="nav_click"
          data-track-lib="nav"
          data-track-value={link.href}
          data-track-label={link.label}
        >{link.label}</a>
      ))}
      {availableLocales.length > 1 && (
        <details class="lang-switch">
          <summary aria-label="Language">{localeMeta[locale].label}</summary>
          <div class="lang-menu">
            {availableLocales.map((item) => (
              <a
                href={alternates[item]}
                hreflang={localeMeta[item].htmlLang}
                lang={localeMeta[item].htmlLang}
                class={item === locale ? 'is-active' : undefined}
                aria-current={item === locale ? 'page' : undefined}
                data-track="language_switch"
                data-track-lib="nav"
                data-track-value={item}
                data-track-label={localeMeta[item].label}
              >{localeMeta[item].label}</a>
            ))}
          </div>
        </details>
      )}
      <a
        class="nav-ext"
        href="https://github.com/sleepy-zone"
        target="_blank"
        rel="noopener"
        data-track="outbound_click"
        data-track-lib="nav"
        data-track-value="github.com"
        data-track-label="GitHub nav"
      >GitHub ↗</a>
    </nav>
  </div>
</header>
