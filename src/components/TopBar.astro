---
const path = Astro.url.pathname;
const links = [
  { href: '/projects/', label: '项目' },
  { href: '/#picks', label: '工具推荐' },
  { href: '/about/', label: '关于' },
];
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">☾</span>Sleepy Zone</a>
    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          class={isActive(link.href) ? 'is-active' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-track="nav_click"
          data-track-lib="nav"
          data-track-value={link.href}
          data-track-label={link.label}
        >{link.label}</a>
      ))}
      <a
        class="nav-ext"
        href="https://github.com/sleepy-zone"
        target="_blank"
        rel="noopener"
        data-track="outbound_click"
        data-track-lib="nav"
        data-track-value="github.com"
        data-track-label="GitHub nav"
      >GitHub ↗</a>
    </nav>
  </div>
</header>
