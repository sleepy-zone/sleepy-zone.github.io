---
import { localeMeta, localePath, locales, ui, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale = 'zh', alternates = {} } = Astro.props;
const path = Astro.url.pathname;
const t = ui[locale];
const projectsHref = localePath(locale, '/projects/');
const toolsHref = localePath(locale, '/tools/');
const links = [
  { href: projectsHref, label: t.nav.projects },
  { href: toolsHref, label: t.nav.tools },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const availableLocales = locales.filter((item) => alternates[item]);
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href={localePath(locale, '/')}><span class="brand-mark" aria-hidden="true">☾</span><span class="brand-text">Sleepy Zone</span></a>
    <nav class="nav" aria-label={locale === 'zh' ? '主导航' : locale === 'en' ? 'Main navigation' : 'メインナビゲーション'}>
      {availableLocales.length > 1 && (
        <details class="lang-switch">
          <summary aria-label="Language">
            <svg class="lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18"></path>
              <path d="M12 3c2.5 2.5 3.8 5.6 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.6-3.8-9S9.5 5.5 12 3Z"></path>
            </svg>
            <span>{localeMeta[locale].label}</span>
            <svg class="lang-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </summary>
          <div class="lang-menu">
            {availableLocales.map((item) => (
              <a
                href={alternates[item]}
                hreflang={localeMeta[item].htmlLang}
                lang={localeMeta[item].htmlLang}
                class={item === locale ? 'is-active' : undefined}
                aria-current={item === locale ? 'page' : undefined}
                data-track="language_switch"
                data-track-lib="nav"
                data-track-value={item}
                data-track-label={localeMeta[item].label}
              >{localeMeta[item].label}</a>
            ))}
          </div>
        </details>
      )}
      {links.map((link) => (
        <a
          href={link.href}
          class={isActive(link.href) ? 'is-active' : undefined}
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-track="nav_click"
          data-track-lib="nav"
          data-track-value={link.href}
          data-track-label={link.label}
        >{link.label}</a>
      ))}
      <a
        class="nav-ext"
        href="https://github.com/sleepy-zone"
        target="_blank"
        rel="noopener"
        data-track="outbound_click"
        data-track-lib="nav"
        data-track-value="github.com"
        data-track-label="GitHub nav"
      >GitHub ↗</a>
    </nav>
  </div>
</header>
