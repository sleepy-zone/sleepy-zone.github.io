---
import { render } from 'astro:content';
import ThoughtImage from './ThoughtImage.astro';
import { formatDate } from '../lib/date';
import { projectBySlug } from '../lib/projects';
import { tagHref, thoughtHref, type Thought } from '../lib/thoughts';

interface Props {
  entry: Thought;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = entry.data.project ? projectBySlug(entry.data.project) : undefined;
---

<article class="thought">
  <div class="body">
    <Content />
    {entry.data.image && (
      <ThoughtImage
        src={entry.data.image}
        alt={entry.data.imageAlt}
        caption={entry.data.imageCaption}
      />
    )}
    {project && (
      <p class="related">相关项目 <a href="/projects/">{project.name}</a></p>
    )}
  </div>

  <footer class="thought-meta">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
    <div class="tags">
      {entry.data.tags.map((tag) => (
        <a class="chip" href={tagHref(tag)}><span>#</span>{tag}</a>
      ))}
    </div>
    <a class="permalink" href={thoughtHref(entry)} aria-label="打开这条想法">↗</a>
  </footer>
</article>
