---
import { tagCounts, tagHref, type Thought } from '../lib/thoughts';

interface Props {
  thoughts: Thought[];
  active?: string;
}

const { thoughts, active } = Astro.props;
const tags = tagCounts(thoughts);
---

<nav class="filters" aria-label="想法标签">
  <a
    href="/thoughts/"
    class={active ? undefined : 'is-active'}
    aria-current={active ? undefined : 'page'}
  >全部 <b>{thoughts.length}</b></a>
  {tags.map(([tag, count]) => (
    <a
      href={tagHref(tag)}
      class={active === tag ? 'is-active' : undefined}
      aria-current={active === tag ? 'page' : undefined}
    >#{tag} <b>{count}</b></a>
  ))}
</nav>
