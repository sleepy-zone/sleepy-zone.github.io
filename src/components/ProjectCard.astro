---
import { ui, localePath, type Locale } from '../i18n/ui';
import { localizeProject } from '../lib/i18n';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  priority?: boolean;
  locale?: Locale;
}

const { project, priority = false, locale = 'zh' } = Astro.props;
const item = localizeProject(project, locale);
const t = ui[locale];
const href = localePath(locale, `/projects/${item.slug}/`);
const label = t.status[item.status];
---

<a
  class="project-card"
  href={href}
  data-track="project_click"
  data-track-lib="projects"
  data-track-id={item.slug}
  data-track-label={item.name}
  data-track-type={item.group}
  data-track-value="detail"
  data-track-free={item.freeDownload ? 'true' : undefined}
>
  <div class="project-cover">
    {item.image ? (
      <img
        src={item.image}
        alt={item.imageAlt ?? item.name}
        width="768"
        height="512"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true">{item.name}</div>
    )}
    <span class={`badge ${item.status}`}>{label}</span>
  </div>

  <div class="project-body">
    <div class="project-title">
      <h3>{item.displayName ?? item.name}</h3>
    </div>
    <p class="project-desc">{item.desc}</p>
    {item.resourceNote && <p class="project-note">{item.resourceNote}</p>}
    {item.freeDownload && (
      <p class="project-free"><span aria-hidden="true">↓</span> {t.project.free}</p>
    )}
    <span class="project-detail-link">{t.project.details} <span aria-hidden="true">→</span></span>
  </div>
</a>
