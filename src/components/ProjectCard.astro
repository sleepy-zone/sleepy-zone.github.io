---
import { statusLabels } from '../data/site';
import { formatStars, projectDetailHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const href = projectDetailHref(project);
const label = statusLabels[project.status];
---

<a
  class="project-card"
  href={href}
  data-track="project_click"
  data-track-lib="projects"
  data-track-id={project.slug}
  data-track-label={project.name}
  data-track-type={project.group}
  data-track-value="detail"
  data-track-free={project.freeDownload ? 'true' : undefined}
>
  <div class="project-cover">
    {project.image ? (
      <img
        src={project.image}
        alt={project.imageAlt ?? project.name}
        width="768"
        height="512"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <div class="cover-fallback" aria-hidden="true">{project.name}</div>
    )}
    <span class={`badge ${project.status}`}>{label}</span>
  </div>

  <div class="project-body">
    <div class="project-title">
      <h3>{project.displayName ?? project.name}</h3>
      {project.stars > 0 && <span class="project-stars">★ {formatStars(project.stars)}</span>}
    </div>
    <p class="project-desc">{project.desc}</p>
    {project.resourceNote && <p class="project-note">{project.resourceNote}</p>}
    {project.freeDownload && (
      <p class="project-free"><span aria-hidden="true">↓</span> 资源可免费打包下载</p>
    )}
    <div class="project-stack">
      {project.stack.map((item) => <span>{item}</span>)}
    </div>
    <span class="project-detail-link">项目详情 <span aria-hidden="true">→</span></span>
  </div>
</a>
