---
import type { Affiliate } from '../lib/affiliates';

interface Props {
  item: Affiliate;
  detail?: boolean;
}

const { item, detail = false } = Astro.props;
const href = detail ? `/tools/${item.id}/` : item.url;
---

<a
  class="promo-card"
  href={href}
  target={detail ? undefined : '_blank'}
  rel={detail ? undefined : item.sponsored ? 'sponsored nofollow noopener' : 'noopener'}
  data-track={detail ? 'tool_card_click' : 'tool_click'}
  data-track-lib="picks"
  data-track-id={item.id}
  data-track-type={item.sponsored ? 'sponsored' : 'recommended'}
  data-track-label={item.title}
>
  <div class="promo-cover">
    {item.image ? (
      <img
        src={item.image}
        alt={item.imageAlt ?? item.title}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="promo-cover-fallback" aria-hidden="true">{item.mark}</div>
    )}
    <span class={`promo-tag${item.sponsored ? ' is-sponsored' : ''}`}>{item.sponsored ? '推广' : '推荐'}</span>
  </div>
  <div class="promo-body">
    <h3>{item.title}</h3>
    <p>{item.desc}</p>
    <span class="promo-link">{detail ? '详情' : item.tag || '查看'} <i aria-hidden="true">{detail ? '→' : '↗'}</i></span>
  </div>
</a>
