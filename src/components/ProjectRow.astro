---
import { statusLabels } from '../data/site';
import { formatStars, projectHref, type Project } from '../lib/projects';

interface Props {
  project: Project;
  index?: number;
  showStatus?: boolean;
}

const { project, index, showStatus = true } = Astro.props;
const href = projectHref(project);
const isExternal = /^https?:\/\//.test(href);
const label = statusLabels[project.status];
---

<a
  class="project"
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
>
  {typeof index === 'number' && <span class="idx">{String(index).padStart(2, '0')}</span>}
  <span class="thumb">
    {project.image ? (
      <img
        src={project.image}
        alt={project.imageAlt ?? project.name}
        width="480"
        height="300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span aria-hidden="true">{project.name.slice(0, 1)}</span>
    )}
  </span>
  <span class="meta">
    <span class="name">
      {project.name}
      {showStatus && <span class={`status ${project.status}`}>{label}</span>}
    </span>
    <span class="desc">{project.desc}</span>
  </span>
  <span class="stack">{project.stack.join(' · ')}</span>
  <span class="stars">
    {project.stars > 0 && (
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path
          d="M6 .7l1.65 3.44 3.75.53-2.72 2.63.65 3.73L6 9.26 2.67 11.03l.65-3.73L.6 4.67l3.75-.53z"
          fill="currentColor"></path>
      </svg>
    )}
    {formatStars(project.stars)}
  </span>
  <span class="arrow" aria-hidden="true">↗</span>
</a>
