---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<BaseLayout title="关于" description="关于 SleepyZone：前端开发者，做开源工具和 AI 绘图素材站。">
  <section class="wrap page-head">
    <p class="kicker">ABOUT · SINCE 2019</p>
    <h1>关于</h1>
  </section>

  <div class="wrap">
    <div class="about-card">
      <div class="about-top">
        <img class="avatar" src="/img/avatar.jpg" alt="SleepyZone 的头像" width="80" height="80" />
        <div class="bio">
          {site.about.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <section class="about-section">
        <h2>NOW</h2>
        <dl class="now-list">
          {site.about.now.map((item) => (
            <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
          ))}
        </dl>
      </section>

      <section class="about-section">
        <h2>ELSEWHERE</h2>
        <ul class="contact-list">
          {site.contacts.map((contact) => (
            <li>
              {contact.href ? (
                <a href={contact.href} target="_blank" rel="noopener">
                  {contact.label}<span>{contact.handle}</span>
                </a>
              ) : (
                <span class="contact-static">{contact.label}<span>{contact.handle}</span></span>
              )}
            </li>
          ))}
        </ul>
      </section>

      <p class="colophon">{site.about.colophon} © {year}</p>
    </div>
  </div>
</BaseLayout>
