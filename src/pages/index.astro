---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusCard from '../components/StatusCard.astro';
import ThoughtItem from '../components/ThoughtItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { formatDate } from '../lib/date';
import { featuredProjects, projects } from '../lib/projects';
import { sortThoughts } from '../lib/thoughts';

const thoughts = (await getCollection('thoughts')).sort(sortThoughts);
const recent = thoughts.slice(0, 4);
const featured = featuredProjects.slice(0, 6);
const latest = thoughts[0]?.data.date;
---

<BaseLayout>
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="kicker">{site.hero.kicker}</p>
      <h1>
        {site.hero.title}<br />
        {site.hero.titleSecond}<span class="accent">{site.hero.titleAccent}</span>{site.hero.titleEnd}
      </h1>
      <p class="lede">{site.hero.lede}</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/thoughts/" data-track="cta_click" data-track-lib="hero" data-track-value="thoughts" data-track-label="读想法">读想法 <span aria-hidden="true">→</span></a>
        <a class="btn" href="/projects/" data-track="cta_click" data-track-lib="hero" data-track-value="projects" data-track-label="看项目">看项目</a>
      </div>
      <p class="now">
        <span class="dot"></span>
        NOW — {site.hero.now}{latest ? ` · 最后一条 ${formatDate(latest)}` : ''}
      </p>
    </div>

    <StatusCard />
  </section>

  <section class="wrap section section-notes">
    <div class="section-head">
      <div>
        <p class="sec-kicker">01 / NOTES</p>
        <h2>最近在想</h2>
      </div>
      <a class="more" href="/thoughts/">全部 {thoughts.length} 条 →</a>
    </div>

    {recent.length > 0 ? (
      <div class="thought-list">
        {recent.map((entry) => <ThoughtItem entry={entry} />)}
      </div>
    ) : (
      <p class="empty">还没有想法，过几天再来看看。</p>
    )}
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div>
        <p class="sec-kicker">02 / PROJECTS</p>
        <h2>在做的东西</h2>
      </div>
      <a class="more" href="/projects/">全部 {projects.length} 个 →</a>
    </div>

    <div class="project-grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
