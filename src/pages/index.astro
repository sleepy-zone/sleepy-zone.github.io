---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AffiliateCard from '../components/AffiliateCard.astro';
import { site } from '../data/site';
import { featuredProjects, projects } from '../lib/projects';
import { affiliates, hasSponsored } from '../lib/affiliates';
import { projectItemList } from '../lib/seo';

const featured = [...featuredProjects]
  .sort((a, b) => {
    const rank = (project: (typeof projects)[number]) => (project.group === 'library' ? 0 : 1);
    return rank(a) - rank(b) || a.order - b.order;
  })
  .slice(0, 6);
---

<BaseLayout structuredData={[projectItemList(featured, 'Sleepy Zone 精选项目与资源')]}>
  <section class="wrap masthead">
    <p class="kicker">{site.hero.kicker}</p>
    <h1>
      <span id="greeting">你好</span>
      <span class="h1-welcome">{site.hero.welcome}</span>
    </h1>
    <script is:inline>
      (() => {
        const hour = new Date().getHours();
        const greeting =
          hour < 5 ? '深夜了' :
          hour < 11 ? '早上好' :
          hour < 14 ? '中午好' :
          hour < 18 ? '下午好' :
          hour < 23 ? '晚上好' : '深夜了';
        const node = document.getElementById('greeting');
        if (node) node.textContent = greeting;
      })();
    </script>
    <div class="masthead-actions">
      <a
        class="btn btn-accent"
        href="#projects"
        data-track="cta_click"
        data-track-lib="home"
        data-track-value="projects"
        data-track-label="项目"
      >项目 <span aria-hidden="true">→</span></a>
      <a
        class="btn"
        href="/tools/"
        data-track="cta_click"
        data-track-lib="home"
        data-track-value="tools"
        data-track-label="工具推荐"
      >工具推荐</a>
    </div>
  </section>

  <section class="wrap section" id="projects">
    <div class="section-head">
      <div>
        <p class="sec-kicker">01 / PROJECTS</p>
        <h2>项目</h2>
      </div>
      <a class="more" href="/projects/">全部 {projects.length} 个 <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-grid home-projects">
      {featured.map((project, index) => <ProjectCard project={project} priority={index < 3} />)}
    </div>
  </section>

  {affiliates.length > 0 && (
    <section class="wrap section" id="picks">
      <div class="section-head">
        <div>
          <p class="sec-kicker">02 / PICKS</p>
          <h2>好用的工具推荐</h2>
        </div>
        <a class="more" href="/tools/">全部 {affiliates.length} 个 <span aria-hidden="true">→</span></a>
      </div>
      <p class="pick-note">
        {hasSponsored
          ? '以下为推广链接，详情页里有官网入口；通过它们购买 / 订阅，我可能获得佣金，价格不变。'
          : '以下是我在用的工具，详情页里有官网入口。'}
      </p>

      <div class="promo-grid">
        {affiliates.map((item) => <AffiliateCard item={item} detail />)}
      </div>
    </section>
  )}
</BaseLayout>
