---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AffiliateCard from '../components/AffiliateCard.astro';
import { site } from '../data/site';
import { featuredProjects, projects } from '../lib/projects';
import { affiliates, hasSponsored } from '../lib/affiliates';

const featured = [...featuredProjects]
  .sort((a, b) => {
    const rank = (project: (typeof projects)[number]) => (project.group === 'library' ? 0 : 1);
    return rank(a) - rank(b) || a.order - b.order;
  })
  .slice(0, 5);
const libraryCount = projects.filter((project) => project.group === 'library').length;
---

<BaseLayout>
  <section class="wrap masthead">
    <p class="kicker">{site.hero.kicker}</p>
    <h1>
      {site.hero.title}<br />
      {site.hero.titleSecond}<span class="accent">{site.hero.titleAccent}</span>{site.hero.titleEnd}
    </h1>
    <p class="lede">{projects.length} 个项目、{libraryCount} 个资源库：{site.hero.lede}</p>
    <div class="masthead-actions">
      <a
        class="btn btn-accent"
        href="#projects"
        data-track="cta_click"
        data-track-lib="home"
        data-track-value="projects"
        data-track-label="看项目"
      >看项目 <span aria-hidden="true">→</span></a>
      <a
        class="btn"
        href="#picks"
        data-track="cta_click"
        data-track-lib="home"
        data-track-value="picks"
        data-track-label="工具推荐"
      >工具推荐</a>
    </div>
    <p class="masthead-stats">
      <b>{projects.length}</b> 个项目 <span>/</span>
      <b>{libraryCount}</b> 个资源库 <span>/</span>
      <b>373</b> 个标签
    </p>
  </section>

  <section class="wrap section" id="projects">
    <div class="section-head">
      <div>
        <p class="sec-kicker">01 / PROJECTS</p>
        <h2>项目</h2>
      </div>
      <a class="more" href="/projects/">全部 {projects.length} 个 <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-grid home-projects">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {affiliates.length > 0 && (
    <section class="wrap section" id="picks">
      <div class="section-head">
        <div>
          <p class="sec-kicker">02 / PICKS</p>
          <h2>好用的工具推荐</h2>
        </div>
      </div>
      <p class="pick-note">
        {hasSponsored
          ? '以下为推广链接，通过它们购买 / 订阅，我可能获得佣金，价格不变。'
          : '以下是我在用的工具，点进去是官网。'}
      </p>

      <div class="promo-grid">
        {affiliates.map((item) => <AffiliateCard item={item} />)}
      </div>
    </section>
  )}
</BaseLayout>
