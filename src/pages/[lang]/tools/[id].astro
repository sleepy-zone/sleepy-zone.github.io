---
import ToolDetailPage from '../../../components/pages/ToolDetailPage.astro';
import { affiliates } from '../../../lib/affiliates';
import { locales, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'zh')
    .flatMap((locale) =>
      affiliates.map((item) => ({
        params: { lang: locale, id: item.id },
        props: { lang: locale, id: item.id },
      })),
    );
}

const { lang, id } = Astro.props;
---

<ToolDetailPage locale={lang as Locale} id={id} />
