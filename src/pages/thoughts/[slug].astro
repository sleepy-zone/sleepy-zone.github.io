---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { projectBySlug } from '../../lib/projects';
import { tagHref, thoughtTitle } from '../../lib/thoughts';
import { excerpt } from '../../lib/text';

export async function getStaticPaths() {
  const thoughts = await getCollection('thoughts');
  return thoughts.map((entry) => ({
    params: { slug: entry.id },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
const entry = await getEntry('thoughts', id);
if (!entry) throw new Error(`Thought not found: ${id}`);
const { Content } = await render(entry);
const title = thoughtTitle(entry, 32);
const project = entry.data.project ? projectBySlug(entry.data.project) : undefined;
---

<BaseLayout title={title} description={excerpt(entry.body, 90)} ogType="article">
  <article class="wrap thought-page">
    <p class="kicker">NOTE · {formatDate(entry.data.date)}</p>
    <h1 class="visually-hidden">{title}</h1>

    <div class="body">
      <Content />
      {entry.data.image && <img class="shot" src={entry.data.image} alt="" />}
      {entry.data.tags.length > 0 && (
        <p class="tags">
          {entry.data.tags.map((tag) => (
            <a href={tagHref(tag)}><span>#</span>{tag}</a>
          ))}
        </p>
      )}
      {project && <p class="related">相关项目 <a href="/projects/">{project.name}</a></p>}
    </div>

    <div class="thought-foot">
      <a href="/thoughts/">← 全部想法</a>
      <span>{entry.data.tags.map((tag) => `#${tag}`).join('  ')}</span>
    </div>
  </article>
</BaseLayout>
