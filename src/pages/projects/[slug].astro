---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectGroups, statusLabels } from '../../data/site';
import { projects, projectBySlug, formatStars } from '../../lib/projects';
import { breadcrumbSchema, projectApplicationSchema } from '../../lib/seo';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { slug: project.slug },
  }));
}

const { slug } = Astro.props;
const project = projectBySlug(slug);
if (!project) throw new Error(`Project not found: ${slug}`);

const group = projectGroups.find((item) => item.id === project.group);
const groupLabel = group?.label ?? '项目';
const statusLabel = statusLabels[project.status];
const detail = project.detail;
const title = project.displayName ?? project.name;
const intro = project.detail?.intro ?? project.desc;
const kindLabel = project.group === 'library' ? '资源库' : '工具';
const description = `${project.desc}（${project.name}）。${project.freeDownload ? '资源支持免费打包下载。' : ''}包含项目介绍、资源数量与访问入口。`;

const related = projects
  .filter((item) => item.slug !== project.slug)
  .sort((a, b) => {
    const sameA = a.group === project.group ? 0 : 1;
    const sameB = b.group === project.group ? 0 : 1;
    return sameA - sameB || a.order - b.order;
  })
  .slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={[
    projectApplicationSchema(project),
    breadcrumbSchema([
      { name: '首页', url: '/' },
      { name: '项目', url: '/projects/' },
      { name: title, url: `/projects/${project.slug}/` },
    ]),
  ]}
>
  <div class="wrap detail-page">
    <nav class="crumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/projects/">项目</a>
      <span>/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <article class="detail-card">
      <header class="detail-head">
        <p class="kicker">PROJECT / {groupLabel}</p>
        <h1>{title}</h1>
        <p class="detail-slug">{project.name}</p>
        <p class="detail-lede">{intro}</p>
        <div class="detail-meta">
          <span class={`meta-pill ${project.status}`}>{statusLabel}</span>
          <span>{kindLabel}</span>
          {project.stars > 0 && <span>★ {formatStars(project.stars)}</span>}
          {project.freeDownload && <span class="meta-free">免费打包下载</span>}
        </div>
      </header>

      {project.image && (
        <div class="detail-hero">
          <img
            src={project.image}
            alt={project.imageAlt ?? project.name}
            width="768"
            height="512"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="detail-actions">
        {project.site && (
          <a
            class="btn btn-accent"
            href={project.site}
            target="_blank"
            rel="noopener"
            data-track="project_open"
            data-track-lib="projects"
            data-track-id={project.slug}
            data-track-label={project.name}
          >打开项目 <span aria-hidden="true">↗</span></a>
        )}
        {project.repo && (
          <a
            class="btn"
            href={project.repo}
            target="_blank"
            rel="noopener"
            data-track="outbound_click"
            data-track-lib="projects"
            data-track-label="GitHub"
          >GitHub <span aria-hidden="true">↗</span></a>
        )}
        <a class="btn" href="/projects/">全部项目</a>
      </div>

      <div class="detail-grid">
        <div class="detail-main">
          {detail?.highlights?.length ? (
            <section class="detail-section">
              <h2>包含什么</h2>
              <ul>
                {detail.highlights.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ) : null}

          {detail?.useCases?.length ? (
            <section class="detail-section">
              <h2>适合用来做什么</h2>
              <ul>
                {detail.useCases.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ) : null}
        </div>

        <aside class="detail-side">
          {project.resourceNote && (
            <div class="detail-fact">
              <span>资源规模</span>
              <strong>{project.resourceNote}</strong>
            </div>
          )}
          <div class="detail-fact">
            <span>技术栈</span>
            <strong>{project.stack.join(' / ')}</strong>
          </div>
          {project.stars > 0 && (
            <div class="detail-fact">
              <span>GitHub Star</span>
              <strong>{formatStars(project.stars)}</strong>
            </div>
          )}
          {project.freeDownload && (
            <div class="detail-free">
              <span>免费</span>
              <strong>资源可免费打包下载</strong>
              <p>在项目站点内提供打包下载入口。</p>
            </div>
          )}
        </aside>
      </div>

      {related.length > 0 && (
        <section class="detail-related">
          <h2>其他项目</h2>
          <div class="related-links">
            {related.map((item) => (
              <a href={`/projects/${item.slug}/`}>{item.displayName ?? item.name} <span aria-hidden="true">→</span></a>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</BaseLayout>
