---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectGroups } from '../../data/site';
import { projects, projectsByGroup } from '../../lib/projects';
import { breadcrumbSchema, projectItemList } from '../../lib/seo';

const online = projects.filter((project) => project.site).length;
const libraryCount = projects.filter((project) => project.group === 'library').length;
const description = `SleepyZone 的 ${projects.length} 个项目：${libraryCount} 个 AI 绘图资源库，${online} 个可在线访问。包含 AI 绘图素材、二次元角色换装、标签词典、设计档案和开源工具。`;
---

<BaseLayout
  title="AI 绘图素材与开源工具"
  description={description}
  structuredData={[
    projectItemList(projects),
    breadcrumbSchema([
      { name: '首页', url: '/' },
      { name: '项目', url: '/projects/' },
    ]),
  ]}
>
  <section class="wrap page-head">
    <p class="kicker">ALL PROJECTS · 2019—2026</p>
    <h1>项目</h1>
    <p class="sub">
      {projects.length} 个项目，{libraryCount} 个 AI 绘图资源库，{online} 个可在线访问。素材支持免费打包下载。
    </p>
  </section>

  <div class="wrap">
    {projectGroups.map((group) => (
      <section class="group">
        <div class="group-head">
          <p class="sec-kicker">{group.index} / {group.label}</p>
          <h2>{group.heading}</h2>
          <p class="gdesc">{group.desc}</p>
        </div>
        <div class="project-grid">
          {projectsByGroup(group.id).map((project, index) => (
            <ProjectCard project={project} priority={index < 2} />
          ))}
        </div>
      </section>
    ))}

    <p class="legend">STARS = GitHub Star，构建时自动同步 · 状态：维护中 / 暂停</p>
  </div>
</BaseLayout>
