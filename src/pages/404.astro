---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="这个页面不存在。" noindex>
  <section class="wrap notfound">
    <div class="notfound-card">
      <p class="kicker">404 / NOT FOUND</p>
      <h1>这个页面不存在。</h1>
      <p>可能被改地址了，也可能从来没做过。</p>
      <div class="links">
        <a class="btn btn-accent" href="/projects/">去项目</a>
        <a class="btn" href="/#picks">工具推荐</a>
        <a class="btn" href="/">回首页</a>
      </div>
    </div>
  </section>
</BaseLayout>
