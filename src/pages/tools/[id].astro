---
import ToolDetailPage from '../../components/pages/ToolDetailPage.astro';
import { affiliates } from '../../lib/affiliates';

export function getStaticPaths() {
  return affiliates.map((item) => ({
    params: { id: item.id },
    props: { id: item.id },
  }));
}

const { id } = Astro.props;
---

<ToolDetailPage locale="zh" id={id} />
