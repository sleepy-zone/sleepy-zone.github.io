---
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { ORGANIZATION_ID, PERSON_ID, SITE_URL, WEBSITE_ID } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  publishedTime?: string;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noindex = false,
  image = '/og.png',
  publishedTime,
  tags = [],
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — AI 绘图素材库与开源工具`;
const robots = noindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'SleepyZone',
  url: `${SITE_URL}/`,
  image: `${SITE_URL}/img/avatar.jpg`,
  description: '前端开发者，做开源工具和 AI 绘图素材库。',
  jobTitle: '前端开发者',
  sameAs: ['https://github.com/sleepy-zone', 'https://twitter.com/zone__online'],
  knowsAbout: ['AI 绘图', '前端开发', '开源工具', 'AI 编程'],
  worksFor: { '@id': ORGANIZATION_ID },
};

const organization = {
  '@type': 'Organization',
  '@id': ORGANIZATION_ID,
  name: site.title,
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/logo-512.png`,
    width: 512,
    height: 512,
  },
  sameAs: ['https://github.com/sleepy-zone', 'https://twitter.com/zone__online'],
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: `${SITE_URL}/`,
  name: site.title,
  description: site.description,
  inLanguage: 'zh-Hans',
  publisher: { '@id': ORGANIZATION_ID },
  author: { '@id': PERSON_ID },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: pageTitle,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': PERSON_ID },
  inLanguage: 'zh-Hans',
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
};

const extras = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, organization, website, webpage, ...extras],
};
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="SleepyZone" />
    <meta name="theme-color" content="#F7F7F4" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-Hans" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href="https://github.com/sleepy-zone" />
    <link rel="me" href="https://twitter.com/zone__online" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:modified_time" content={publishedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@zone__online" />
    <meta name="twitter:creator" content="@zone__online" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <TopBar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      window.ANALYTICS = {
        providers: [{ provider: 'clarity', id: 'r1wmvdsf4a' }],
      };
    </script>
    <script is:inline src="/analytics.js" defer></script>
  </body>
</html>
