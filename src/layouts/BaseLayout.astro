---
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { PERSON_ID, SITE_URL, WEBSITE_ID } from '../lib/seo';
import { localeMeta, ui, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  publishedTime?: string;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  noindex = false,
  image = '/og.png',
  publishedTime,
  tags = [],
  structuredData,
  locale = 'zh',
  alternates = {},
} = Astro.props;

const meta = localeMeta[locale];
const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — AI 绘图素材库与开源工具`;
const robots = noindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const alternateUrls = Object.fromEntries(
  Object.entries(alternates).map(([key, path]) => [key, new URL(path, siteUrl).href]),
) as Partial<Record<Locale, string>>;
const xDefault = alternateUrls.zh ?? canonical.href;

const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'SleepyZone',
  url: `${SITE_URL}/`,
  image: `${SITE_URL}/img/avatar.jpg`,
  description: 'Frontend developer building open-source tools and AI drawing resources.',
  jobTitle: 'Frontend developer',
  sameAs: ['https://github.com/sleepy-zone', 'https://twitter.com/zone__online'],
  knowsAbout: ['AI drawing', 'Frontend', 'Open source', 'AI coding'],
  worksFor: { '@id': `${SITE_URL}/#organization` },
};

const organization = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: site.title,
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/logo-512.png`,
    width: 512,
    height: 512,
  },
  sameAs: ['https://github.com/sleepy-zone', 'https://twitter.com/zone__online'],
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: `${SITE_URL}/`,
  name: site.title,
  description,
  inLanguage: ['zh-Hans', 'en', 'ja'],
  publisher: { '@id': `${SITE_URL}/#organization` },
  author: { '@id': PERSON_ID },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: pageTitle,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': PERSON_ID },
  inLanguage: meta.htmlLang,
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
};

const extras = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, organization, website, webpage, ...extras],
};
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="SleepyZone" />
    <meta name="theme-color" content="#F7F7F4" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternateUrls).map(([key, url]) => (
      <link rel="alternate" hreflang={localeMeta[key as Locale].htmlLang} href={url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href="https://github.com/sleepy-zone" />
    <link rel="me" href="https://twitter.com/zone__online" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={meta.ogLocale} />
    {Object.keys(alternateUrls)
      .filter((key) => key !== locale)
      .map((key) => (
        <meta property="og:locale:alternate" content={localeMeta[key as Locale].ogLocale} />
      ))}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta property="article:modified_time" content={publishedTime} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@zone__online" />
    <meta name="twitter:creator" content="@zone__online" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[locale].skip}</a>
    <TopBar locale={locale} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script is:inline>
      window.ANALYTICS = {
        providers: [{ provider: 'clarity', id: 'r1wmvdsf4a' }],
      };
    </script>
    <script is:inline src="/analytics.js" defer></script>
  </body>
</html>
